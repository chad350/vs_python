  "창 전환 골격": {
    "prefix": "selwin",
    "body": [
      "root_handle = driver.current_window_handle",
      "wait.until(EC.number_of_windows_to_be(${1:2}), \"새 창이 열리지 않았습니다\")",
      "for handle in driver.window_handles:",
      "    if handle != root_handle:",
      "        driver.switch_to.window(handle)",
      "        break",
      "print(\"현재 창 :\", driver.title)",
      "$0",
      "driver.close()",
      "driver.switch_to.window(root_handle)"
    ],
    "description": "root_handle 보관 → 새 창 대기 → 전환 → 작업 → 복귀",
    "scope": "python"
  },
